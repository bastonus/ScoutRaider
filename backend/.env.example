# .env.example - Configuration pour ScoutRaider Backend
# Copier vers .env et remplir les valeurs

# App
APP_NAME=ScoutRaider API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api

# Database (PostgreSQL)
DB_USER=scoutraider
DB_PASS=changeme_secure_password
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@postgres:5432/scoutraider

# JWT Auth
SECRET_KEY=generate-with-openssl-rand-base64-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# Garage S3 (Coolify - ScoutRaider storage)
GARAGE_ENDPOINT=https://s3-scoutraider.silverhorse.fr
GARAGE_PUBLIC_URL=https://s3-scoutraider.silverhorse.fr
GARAGE_ACCESS_KEY=your-garage-access-key
GARAGE_SECRET_KEY=your-garage-secret-key
GARAGE_BUCKET=scoutraider-assets
GARAGE_REGION=garage

# CORS
CORS_ORIGINS=["https://scoutraider.app","https://app.scoutraider.app","http://localhost:5173"]

# Admin Garage (pour référence)
# Garage Admin URL: https://admin-scoutraider.silverhorse.fr
# Garage Admin Token: zOEkyxuZmZUtjVCT3N9GdgK5sKQIFcN3
# Garage Web UI: https://web-scoutraider.silverhorse.fr