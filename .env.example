# .env.example - Configuration frontend ScoutRaider
# Copier vers .env.local pour développement local

# API Backend
VITE_API_URL=http://localhost:8000

# Pour Electron en production (build)
# VITE_API_URL=https://api.scoutraider.app

# Garage S3 Public URL (pour affichage direct des images)
VITE_S3_PUBLIC_URL=https://s3-scoutraider.silverhorse.fr