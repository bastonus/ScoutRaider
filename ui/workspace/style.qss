/* =============================================
   Scout Design Suite — Photoshop CC Dark Theme
   Exact Adobe-style charcoal/neutral palette
   ============================================= */

/* --- Global Base --- */
QMainWindow, QDialog, QWidget {
    background-color: #535353;
    color: #cccccc;
    font-family: 'Segoe UI', 'Adobe Clean', 'Helvetica Neue', sans-serif;
    font-size: 11px;
}

QMainWindow::separator {
    background: #1d1d1d;
    width: 1px;
    height: 1px;
}

/* --- Menu Bar (Very dark top bar like PS) --- */
QMenuBar {
    background-color: #3c3c3c;
    color: #cccccc;
    padding: 1px 0;
    border: none;
    font-size: 11px;
}

QMenuBar::item {
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #505050;
}

QMenu {
    background-color: #353535;
    border: 1px solid #252525;
    padding: 2px 0;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
}

QMenu::item:selected {
    background-color: #2d8ceb;
    color: white;
}

QMenu::separator {
    height: 1px;
    background: #484848;
    margin: 2px 0;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #1d1d1d;
    color: #999999;
    font-size: 10px;
    padding: 1px 6px;
    border-top: 1px solid #252525;
}

/* --- Toolbars --- */
QToolBar {
    background-color: #535353;
    border: none;
    spacing: 1px;
    padding: 2px;
}

QToolBar::separator {
    background: #3c3c3c;
    width: 1px;
    margin: 3px 1px;
}

QToolButton {
    background: transparent;
    border: none;
    padding: 4px 6px;
    color: #cccccc;
    font-size: 11px;
}

QToolButton:hover {
    background-color: #606060;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #2d8ceb;
    color: white;
}

/* --- Dock Widgets (Adobe-style panel headers) --- */
QDockWidget {
    color: #cccccc;
    font-size: 10px;
    titlebar-close-icon: url(none);
    titlebar-normal-icon: url(none);
}

QDockWidget::title {
    background-color: #3c3c3c;
    padding: 5px 8px;
    border-bottom: 1px solid #303030;
    font-weight: normal;
    font-size: 11px;
    color: #cccccc;
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    background: transparent;
    padding: 2px;
}

/* --- Tab Bar (Adobe-style, blue indicator, top position) --- */
QTabWidget::pane {
    border: none;
    background-color: #535353;
}

QTabBar {
    background-color: #3c3c3c;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #3c3c3c;
    color: #999999;
    padding: 6px 14px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 10px;
    min-width: 60px;
}

QTabBar::tab:selected {
    color: #ffffff;
    background-color: #4a4a4a;
    border-bottom: 2px solid #2d8ceb;
}

QTabBar::tab:hover:!selected {
    color: #cccccc;
    background-color: #454545;
    border-bottom: 2px solid #555555;
}

/* Blue drop indicator when dragging docks */
QMainWindow::separator:hover {
    background: #2d8ceb;
}

QRubberBand {
    background-color: rgba(45, 140, 235, 0.25);
    border: 2px solid #2d8ceb;
}

/* --- Group Boxes (Subtle section dividers) --- */
QGroupBox {
    border: none;
    border-top: 1px solid #484848;
    margin-top: 12px;
    padding: 8px 0 4px 0;
    background: transparent;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 0px;
    padding: 0 4px;
    color: #999999;
    font-weight: normal;
    font-size: 10px;
}

/* --- Buttons (Flat PS style) --- */
QPushButton {
    background-color: #4a4a4a;
    border: 1px solid #3c3c3c;
    color: #cccccc;
    padding: 5px 10px;
    font-size: 11px;
}

QPushButton:hover {
    background-color: #555555;
    border-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #2d8ceb;
    border-color: #2d8ceb;
    color: white;
}

QPushButton:disabled {
    background-color: #3c3c3c;
    color: #666666;
    border-color: #363636;
}

/* Export button — primary action emphasis */
QPushButton#exportButton {
    background-color: #2d8ceb;
    color: white;
    border: 1px solid #2577cc;
    font-weight: 600;
    padding: 8px 14px;
}

QPushButton#exportButton:hover {
    background-color: #3d9cff;
}

QPushButton#exportButton:pressed {
    background-color: #1a6cc7;
}

/* --- Inputs (Recessed dark fields like PS) --- */
QComboBox, QLineEdit, QSpinBox {
    background-color: #2b2b2b;
    border: 1px solid #1d1d1d;
    color: #cccccc;
    padding: 3px 6px;
    font-size: 11px;
    selection-background-color: #2d8ceb;
}

QComboBox:hover, QLineEdit:hover, QSpinBox:hover {
    border-color: #555555;
}

QComboBox:focus, QLineEdit:focus, QSpinBox:focus {
    border-color: #2d8ceb;
}

QComboBox::drop-down {
    border: none;
    padding-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #353535;
    border: 1px solid #252525;
    selection-background-color: #2d8ceb;
    color: #cccccc;
    padding: 2px;
}

/* --- Sliders (PS-style thin) --- */
QSlider::groove:horizontal {
    border: none;
    height: 3px;
    background: #1d1d1d;
}

QSlider::handle:horizontal {
    background: #999999;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border: 1px solid #2b2b2b;
}

QSlider::handle:horizontal:hover {
    background: #bbbbbb;
}

QSlider::sub-page:horizontal {
    background: #2d8ceb;
}

/* --- Checkboxes --- */
QCheckBox {
    color: #cccccc;
    spacing: 5px;
    font-size: 11px;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #666666;
    background-color: #2b2b2b;
}

QCheckBox::indicator:checked {
    background-color: #2d8ceb;
    border-color: #2d8ceb;
}

QCheckBox::indicator:hover {
    border-color: #888888;
}

/* --- Labels --- */
QLabel {
    color: #cccccc;
    font-size: 11px;
    background: transparent;
}

/* --- Lists (Adobe layers panel) --- */
QListWidget {
    background-color: #353535;
    border: none;
    color: #cccccc;
    outline: none;
}

QListWidget::item {
    padding: 5px 8px;
    border-bottom: 1px solid #303030;
}

QListWidget::item:hover {
    background-color: #404040;
}

QListWidget::item:selected {
    background-color: #2d8ceb;
    color: white;
}

/* --- Scroll Bars (Thin subtle) --- */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #666666;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #888888;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #666666;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #888888;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* --- Scroll Area --- */
QScrollArea {
    background-color: transparent;
    border: none;
}

/* --- Progress --- */
QProgressBar {
    background-color: #2b2b2b;
    border: 1px solid #1d1d1d;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: #2d8ceb;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #1d1d1d;
    color: #cccccc;
    border: 1px solid #353535;
    padding: 3px 6px;
    font-size: 11px;
}
