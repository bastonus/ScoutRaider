{
  "name": "scoutraider",
  "private": true,
  "version": "0.5.0",
  "description": "Application de planification et génération de carnets de raid scout.",
  "author": "Pierre-Albéric Théobald",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:mac": "vite build && electron-builder --mac",
    "electron:build:linux": "vite build && electron-builder --linux"
  },
  "build": {
    "appId": "com.scoutraider.suite",
    "productName": "ScoutRaider",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python-dist",
        "to": "python-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bastonus",
        "repo": "ScoutRaider"
      }
    ],
    "fileAssociations": [
      {
        "ext": "srdoc",
        "name": "ScoutRaider Document",
        "role": "Editor",
        "icon": "build/icon.png"
      }
    ]
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@ckeditor/ckeditor5-react": "^11.1.2",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "archiver": "^7.0.1",
    "dexie": "^4.4.7",
    "dockview": "^5.2.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.3",
    "fflate": "^0.8.3",
    "flexlayout-react": "^0.8.19",
    "geographiclib-geodesic": "^2.0.0",
    "katex": "^0.16.47",
    "leaflet": "^1.9.4",
    "lru-cache": "^10.2.0",
    "lucide-react": "^0.363.0",
    "mammoth": "^1.12.0",
    "marked": "^18.2.0",
    "quill-image-resize-module-react": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.6",
    "electron-builder": "^24.13.3",
    "typescript": "^6.0.2",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "esbuild@0.21.5": true
  }
}
